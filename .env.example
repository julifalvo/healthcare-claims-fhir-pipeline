# Copy to .env to override docker compose defaults. All values are optional for local use.

# Secrets shared by the Airflow api-server, scheduler and dag-processor. Change them outside localhost.
AIRFLOW_JWT_SECRET=local-dev-only-change-me
AIRFLOW_API_SECRET_KEY=local-dev-only-change-me

# Memory per Spark driver. Two Spark tasks run concurrently (Airflow pool "spark").
SPARK_DRIVER_MEMORY=1g

# Quality gate: fail the run if any entity quarantines more than this share of records.
MAX_QUARANTINE_RATE=0.05
